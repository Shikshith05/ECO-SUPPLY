# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/

# Virtual environment (single env, created by setup_env.py)
.venv/
# legacy env folders from older setups
venv/
env/

# Environment variables
.env
*.env

# Flask
instance/
.webassets-cache

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data files (large — don't commit raw CSVs)
data/raw/
data/processed/*.csv
data/external/
uploads/

# Trained models (large binary files — use Git LFS or cloud storage)
saved_models/*.pkl
saved_models/*.joblib
saved_models/*.h5
saved_models/*.pt

# Config with secrets (setup_env.py copies config.yaml.example -> config.yaml)
config/config.yaml

# OSMnx HTTP cache
cache/

# Generated benchmark smoke output (quick runs are not for reporting)
results/*_quick*

# OS
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
logs/

# Coverage / testing
.coverage
htmlcov/
.pytest_cache/
