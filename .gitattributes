# Normalise line endings: text files are stored with LF in the repository,
# whatever core.autocrlf each contributor uses; checkouts follow the local platform.
* text=auto

*.py text diff=python
*.md text
*.html text
*.css text
*.js text
*.json text
*.yaml text
*.yml text
*.csv text
*.ini text
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary artifacts
*.png binary
*.jpg binary
*.joblib binary
*.pkl binary
*.npz binary
*.ipynb text eol=lf
